<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lc_rm_serial_wlz</name>
  <version>0.0.1</version>
  <description>ROS 2 serial communication node for RoboMaster based on new protocol</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>MIT</license>

  <!-- 构建工具 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 依赖 -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  
  <!-- 自定义消息依赖 -->
  <depend>auto_aim_interfaces</depend>

  <!-- 串口驱动依赖 (如果是 transport_drivers 里的包，通常叫 serial_driver) -->
  <depend>serial_driver</depend>

  <!-- 测试依赖 (可选) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>